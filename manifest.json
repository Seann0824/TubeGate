{
  "manifest_version": 3,
  "name": "TubeGate",
  "version": "0.2.0",
  "description": "按自定义规则过滤 YouTube 推荐视频，支持恢复显示。使用自己的 TypeSafe API Key。",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.typesafe.ai/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "TubeGate",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png"
    }
  },
  "options_page": "src/settings.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/shared/core.js",
        "src/core/content.js",
        "src/core/adapters.js",
        "src/adapters/youtube/urls.js",
        "src/adapters/youtube/index.js",
        "src/content.js"
      ],
      "css": [
        "src/styles/content.css",
        "src/adapters/youtube/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
